program Cipher {
  size d = 2
  veil Budget key[1] depth[d] under {
    add[1], mul[7], renew[20]
  } stage[prod] {
    param[10] room[1]
    param[20] room[2]
    input x: enc[1,d] state {terms[1], slots[1], query[0]}
    input y: enc[1,d] state {terms[2], slots[1], query[0]}
    term renew((x * y) * trim[1](x))
  }
  term 0
}